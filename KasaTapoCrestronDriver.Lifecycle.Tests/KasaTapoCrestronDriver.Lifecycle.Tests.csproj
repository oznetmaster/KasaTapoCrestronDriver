<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>KasaClient.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\..\.runsettings</RunSettingsFilePath>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- The net472 SDK needs processor-only ManagedUtilitiesCE to construct entities.
       Exercise the actual sensor sources with the SDK's desktop-compatible target here;
       the existing net472 suite continues to verify the production build. -->
  <Import Project="DesktopTest.Local.props" Condition="Exists('DesktopTest.Local.props')" />
  <ItemGroup>
    <Compile Remove="UnusedProcessorBaselineType.cs" />
    <Compile Include="../KasaTapoCrestronDriver/*.cs" Exclude="../KasaTapoCrestronDriver/DriverEntryPoint.cs" Link="Driver/%(Filename)%(Extension)" />
    <Compile Include="../KasaTapoCrestronDriver/Definitions/*.cs" Link="Driver/Definitions/%(Filename)%(Extension)" />
    <Reference Include="Renci.SshNet"><HintPath>../lib/Renci.SshNet/Renci.SshNet.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Newtonsoft.Json.Compact" Condition="Exists('$(CompactJsonPath)')"><Aliases>compactjson</Aliases><HintPath>$(CompactJsonPath)</HintPath><Private>true</Private></Reference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
    <None Include="../KasaTapoCrestronDriver/IncludeInPkg/**/*" Exclude="../KasaTapoCrestronDriver/IncludeInPkg/**/*.xsd" Link="DriverTestData/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />


    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="27.0.24" />
    <PackageReference Include="KasaTapoClient" Version="1.8.1" />
    <Using Include="NUnit.Framework" />

  </ItemGroup>
  <ItemGroup>
    <None Include="../KasaTapoCrestronDriver/KasaTapoCrestronDriver.json" Link="DriverTestData/DriverDefinition.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
