<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	 <TargetFramework>net8.0</TargetFramework>
	  <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	 <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	 <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
	 <NoDefaultExcludes>true</NoDefaultExcludes>
	 <IncludeBuildOutput>false</IncludeBuildOutput>
		<NoWarn>$(NoWarn);CS2008;NU5110;NU5111;NU5128</NoWarn>
	 <PackageType>Template</PackageType>
	 <PackageId>CrestronHome.DeviceDriver.Template</PackageId>
	 <Title>CrestronHome Device Driver Template</Title>
	 <Description>dotnet new and Visual Studio project template for a Crestron Home SDK V2 device driver targeting .NET Framework 4.7.2.</Description>
	 <Authors>Neil Colvin</Authors>
	 <Company>Neil Colvin</Company>
	 <PackageTags>dotnet-new;template;crestron;crestron-home;driver</PackageTags>
	 <PackageProjectUrl>https://github.com/username/reponame</PackageProjectUrl>
	 <RepositoryUrl>https://github.com/username/reponame</RepositoryUrl>
	 <RepositoryType>git</RepositoryType>
	 <PublishRepositoryUrl>true</PublishRepositoryUrl>
	 <PackageReadmeFile>README.md</PackageReadmeFile>
	 <PackageLicenseFile>LICENSE</PackageLicenseFile>
	 <Version>1.0.0</Version>
	 <IsPackable>true</IsPackable>
	 <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	 <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
	 <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	 <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
	 <None Include="README.md" Pack="true" PackagePath="\" />
	 <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
	 <Content Include=".template.config\**\*;KasaTapoCrestronDriver\**\*;KasaTapoCrestronDriver.slnx;README.md;LICENSE" Exclude="**\bin\**;**\obj\**;**\*.user;**\*.suo;KasaTapoCrestronDriver\KasaTapoCrestronDriver.csproj.user" Pack="true" PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="PlatformDriver.cs" />
  </ItemGroup>
</Project>
