<?xml version="1.0" encoding="utf-8" ?>
<uidefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://prd-use-rad-assets.azurewebsites.net/ExtensionsSchemaDefinition.xsd">
  <version ver="2.0" />
  <tile icon="{tileIcon}" status="{deviceStatus}" navigation="show:MainPage" showinhomepage="#false" showinroompage="#true" />
  <layouts>
	 <layout id="MainPage" title="{deviceLabel}" isdefaultlayout="#true">
		<controls>
		  <textdisplay id="DeviceStatusDisplay" title="^ChildStatusTitle" line1label="{deviceStatus}" />
		  <statusandbutton id="ChildActionButton" label="^ChildActionTitle" status="{deviceStatus}" buttonlabel="{actionLabel}" buttonaction="command:performAction" />
		</controls>
	 </layout>
  </layouts>
  <alerts />
</uidefinition>
