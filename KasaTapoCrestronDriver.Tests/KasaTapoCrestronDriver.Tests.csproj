<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- Match the published client test friend assembly, as the desktop lifecycle harness does. -->
    <AssemblyName>KasaClient.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\..\.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <!-- Keep the memory facade aligned with the published client on net472. -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- Aliased so the ILRepack-merged KasaTapoClient types embedded in KasaTapoCrestronDriver.dll (e.g.
        LightState, DeviceFeature) do not collide (CS0433) with the same types from the direct KasaTapoClient
        reference below. Files that need driver-only types (e.g. LightTuningDecisions) must declare
        `extern alias driverassembly;` and qualify types as `driverassembly::KasaTapoCrestronDriver.*`.
        SkipMergeDependencies=true disables the driver's post-build ILRepack merge for this reference, so the
        driver assembly's KasaTapoClient types stay identical (same physical DLL) to this project's own
        KasaTapoClient package reference above - otherwise KasaDevice/DeviceType/etc. become distinct,
        non-convertible types (CS1503) between the two assemblies. Because AdditionalProperties makes
        MSBuild treat this as a distinct instance of KasaTapoCrestronDriver.csproj from the solution's normal
        build of that project, the release workflow must not build both instances in parallel (see
        BuildInParallel note in release-package.yml), otherwise both instances race to write the same
        obj/bin outputs and a CS2012 file-lock error can occur. -->
  <ItemGroup>
    <ProjectReference Include="..\KasaTapoCrestronDriver\KasaTapoCrestronDriver.csproj">
      <Aliases>global,driverassembly</Aliases>
      <AdditionalProperties>SkipMergeDependencies=true;DeployAfterBuild=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Must reference the exact same KasaTapoClient assembly as KasaTapoCrestronDriver.csproj (the NuGet
        package), not a local sibling build, otherwise KasaDevice/DeviceType/etc. resolve as distinct
        types (CS1503) between this project and the driverassembly-aliased ProjectReference above. -->
  <ItemGroup>
    <PackageReference Include="KasaTapoClient" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\KasaTapoCrestronDriver.Lifecycle.Tests\*Tests.cs" Link="Lifecycle\%(Filename)%(Extension)" />
    <Compile Include="..\KasaTapoCrestronDriver.Lifecycle.Tests\TestTaskExtensions.cs" Link="Lifecycle\TestTaskExtensions.cs" />
    <None Include="..\KasaTapoCrestronDriver\IncludeInPkg\sensor\uidefinitions\UiDefinitionBasic.xml" Link="DriverTestData\sensor\uidefinitions\UiDefinitionBasic.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KasaTapoCrestronDriver\IncludeInPkg\outlet\uidefinitions\*.xml" Link="DriverTestData\outlet\uidefinitions\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\KasaTapoCrestronDriver.Lifecycle.Tests\DriverTestPaths.cs" Link="Lifecycle\DriverTestPaths.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../KasaTapoCrestronDriver/KasaTapoCrestronDriver.json" Link="DriverTestData/DriverDefinition.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
