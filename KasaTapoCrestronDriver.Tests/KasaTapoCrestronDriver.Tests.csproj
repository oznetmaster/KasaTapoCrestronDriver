<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.3.3" />
    <!-- KasaTapoClient.dll is referenced directly via HintPath (below) rather than as a PackageReference,
          so its transitive System.Memory 4.6.3 dependency isn't pulled into this project's dependency graph.
          Without this explicit reference, NuGet resolves an older System.Memory (4.5.5 / asm version 4.0.1.2)
          from the test-infra packages, causing an MSB3277 conflict with the version KasaTapoClient needs
          (asm version 4.0.5.0). Keep this version aligned with KasaTapoClient.csproj's System.Memory reference. -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!-- Aliased so the ILRepack-merged KasaTapoClient types embedded in KasaTapoCrestronDriver.dll (e.g.
        LightState, DeviceFeature) do not collide (CS0433) with the same types from the direct KasaTapoClient
        reference below. Files that need driver-only types (e.g. LightTuningDecisions) must declare
        `extern alias driverassembly;` and qualify types as `driverassembly::KasaTapoCrestronDriver.*`.
        Note: no AdditionalProperties are set here (e.g. SkipMergeDependencies) - doing so would make MSBuild
        build KasaTapoCrestronDriver.csproj as a second, distinct project instance with different global
        properties, racing the solution's normal build of the same project and causing CS2012 file-lock
        errors when both write to the same obj/bin paths. The driver project instead skips its ILRepack
        merge for Debug builds unconditionally (see KasaTapoCrestronDriver.csproj), so the driver assembly's
        KasaTapoClient types stay identical (same physical DLL) to this project's own KasaTapoClient package
        reference above - otherwise KasaDevice/DeviceType/etc. become distinct, non-convertible types
        (CS1503) between the two assemblies. -->
  <ItemGroup>
    <ProjectReference Include="..\KasaTapoCrestronDriver\KasaTapoCrestronDriver.csproj">
      <Aliases>driverassembly</Aliases>
    </ProjectReference>
  </ItemGroup>

  <!-- Must reference the exact same KasaTapoClient assembly as KasaTapoCrestronDriver.csproj (the NuGet
        package), not a local sibling build, otherwise KasaDevice/DeviceType/etc. resolve as distinct
        types (CS1503) between this project and the driverassembly-aliased ProjectReference above. -->
  <ItemGroup>
    <PackageReference Include="KasaTapoClient" Version="1.3.1" />
  </ItemGroup>

</Project>
